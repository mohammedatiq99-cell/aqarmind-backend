# Application
APP_NAME=Aqarmind API
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# Azure OpenAI / Microsoft Foundry
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=REPLACE_WITH_LOCAL_SECRET
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=YOUR_MODEL_DEPLOYMENT

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH-SERVICE.search.windows.net
AZURE_SEARCH_API_KEY=REPLACE_WITH_LOCAL_SECRET
AZURE_SEARCH_INDEX=YOUR_SEARCH_INDEX
AZURE_SEARCH_SEMANTIC_CONFIG=YOUR_SEMANTIC_CONFIG

# Azure SQL
SQL_SERVER=YOUR-SERVER.database.windows.net
SQL_DATABASE=YOUR_DATABASE
SQL_USERNAME=REPLACE_WITH_LOCAL_USERNAME
SQL_PASSWORD=REPLACE_WITH_LOCAL_SECRET
SQL_DRIVER=ODBC Driver 18 for SQL Server

# Usage controls
MAX_INPUT_CHARS=6000
MAX_OUTPUT_TOKENS=800
SESSION_QUESTION_LIMIT=25
